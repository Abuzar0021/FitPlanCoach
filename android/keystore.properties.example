# Local upload-key signing config for release builds.
#
# Copy this to `keystore.properties` (same directory) and fill in real
# values — that file is gitignored and must never be committed.
#
#   cp keystore.properties.example keystore.properties
#
# This is your UPLOAD key, not Google's production signing key — Play App
# Signing re-signs the AAB with the key it manages after you upload. You
# still need an upload key to sign the AAB before you can upload it at all.
#
# Don't have a keystore yet? Generate one (do this once, back the file up
# somewhere safe — losing it means you can no longer upload updates under
# the same upload-key identity, though Play App Signing's key-reset flow can
# recover from that):
#
#   keytool -genkeypair -v -keystore fitplancoach-upload.jks \
#     -alias fitplancoach -keyalg RSA -keysize 2048 -validity 9125
#
# storeFile is resolved relative to the android/ directory (this file's location).
storeFile=fitplancoach-upload.jks
storePassword=
keyAlias=fitplancoach
keyPassword=
