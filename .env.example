# FitPlanCoach environment variables.
# Copy to .env (or set in your host) and fill in. Never commit real secrets.

# --- Supabase: client (exposed to the browser, build-time inlined) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase: server only (NEVER prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Play purchase verification: server only ---
# Required for src/lib/billing.functions.ts to verify purchases and unlock Pro.
# Without it, verification fails closed and premium is never granted.
# Provide EITHER the full service-account JSON on one line...
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# ...OR the client email + private key separately (use \n for newlines in the key):
GOOGLE_PLAY_SA_EMAIL=
GOOGLE_PLAY_SA_PRIVATE_KEY=

# --- Transactional email (server only), if used ---
LOVABLE_API_KEY=

# --- Marketing site ---
# Set to your live Play listing to flip "Coming soon" CTAs to real links, e.g.
# https://play.google.com/store/apps/details?id=com.fitplancoach.app
VITE_PLAY_STORE_URL=
