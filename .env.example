# FitPlanCoach environment variables.
# Copy to .env (or set in your host) and fill in. Never commit real secrets.

# --- Supabase: client (exposed to the browser, build-time inlined) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase: server only (NEVER prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Play purchase verification: server only ---
# Required for src/lib/billing.functions.ts to verify purchases and unlock Pro.
# Without it, verification fails closed and premium is never granted.
# Provide EITHER the full service-account JSON on one line...
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# ...OR the client email + private key separately (use \n for newlines in the key):
GOOGLE_PLAY_SA_EMAIL=
GOOGLE_PLAY_SA_PRIVATE_KEY=

# --- Google Play Real-Time Developer Notifications: server only ---
# A webhook secret you generate yourself (e.g. `openssl rand -hex 32`) — not
# a Google credential. See src/routes/api/public/google-play/rtdn.ts.
GOOGLE_PLAY_RTDN_SECRET=

# --- Google Play Integrity: client (build-time), optional hardening ---
# Your Cloud project number linked to the Play Console app (Play Console ->
# your app -> App integrity, or Google Cloud Console -> project settings).
# Leave unset to skip Play Integrity entirely — purchases still work exactly
# the same, verified purely by the purchase token as always.
VITE_GOOGLE_PLAY_CLOUD_PROJECT_NUMBER=

# --- Transactional email (server only), if used ---
LOVABLE_API_KEY=

# --- Marketing site ---
# Set to your live Play listing to flip "Coming soon" CTAs to real links, e.g.
# https://play.google.com/store/apps/details?id=com.fitplancoach.app
VITE_PLAY_STORE_URL=

# --- Google AdSense ad units: client (build-time), optional ---
# The AdSense account/client id (ca-pub-6853704869343091) is already wired in
# globally (src/routes/__root.tsx) and needs no env var. These four are the
# per-placement ad UNIT ids you create in the AdSense dashboard — each
# placement (src/components/ads) stays invisible until its id is set here.
VITE_ADSENSE_SLOT_TOP_ARTICLE=
VITE_ADSENSE_SLOT_IN_CONTENT=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_BOTTOM_ARTICLE=
