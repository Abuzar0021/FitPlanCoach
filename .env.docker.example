# FitPlanCoach — Docker deployment env.
# Copy to `.env.docker` and fill in. NEVER commit `.env.docker` (it is gitignored).
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# Two classes of variable:
#   [BUILD]   VITE_* — inlined into the client bundle at build time. Changing
#             them requires `--build` (a rebuild). They are public by design.
#   [RUNTIME] everything else — read by the server at runtime from the container
#             environment. These are SECRETS; keep this file private (chmod 600).

# ---- Host port (loopback publish target for your reverse proxy) ----
# Any free port that is NOT 80, 443, or 3000 (those belong to OmniStack).
HOST_PORT=8080

# ---- [BUILD] Supabase client (browser, public) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ---- [BUILD] Marketing ----
# Set to your live Play listing to flip "Coming soon" CTAs to real links, e.g.
# https://play.google.com/store/apps/details?id=com.fitplancoach.app
VITE_PLAY_STORE_URL=

# ---- [BUILD] Google Play Integrity, optional hardening ----
# Your Cloud project number linked to the Play Console app (Play Console ->
# your app -> App integrity). Leave unset to skip Play Integrity entirely —
# purchases still work exactly the same either way.
VITE_GOOGLE_PLAY_CLOUD_PROJECT_NUMBER=

# ---- [BUILD] Google AdSense ad units, optional ----
# The AdSense client id is already wired in globally and needs no env var.
# These are the per-placement ad unit ids from the AdSense dashboard — each
# placement stays invisible until its id is set here. Requires a rebuild
# (--build) to take effect since these are build-time values.
VITE_ADSENSE_SLOT_TOP_ARTICLE=
VITE_ADSENSE_SLOT_IN_CONTENT=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_BOTTOM_ARTICLE=

# ---- [RUNTIME] Supabase server ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- [RUNTIME] Google Play purchase verification (server) ----
# Provide EITHER the full service-account JSON on one line...
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# ...OR the email + private key separately (use \n for newlines in the key):
GOOGLE_PLAY_SA_EMAIL=
GOOGLE_PLAY_SA_PRIVATE_KEY=

# ---- [RUNTIME] Google Play Real-Time Developer Notifications (server) ----
# A webhook secret YOU generate (e.g. `openssl rand -hex 32`) — not a Google
# credential. Put the same value in the Pub/Sub push subscription URL as
# ?token=<this>. See src/routes/api/public/google-play/rtdn.ts for the full
# setup steps. Without this set, the RTDN endpoint rejects every request and
# subscription renewals/cancellations are only picked up when a user opens
# the app and it happens to re-verify (purchase or manual restore).
GOOGLE_PLAY_RTDN_SECRET=

# ---- [RUNTIME] Transactional email (optional) ----
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
